<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('#projects .vz-traffic__svg').forEach(function(svg) {
      if (!svg.pauseAnimations) return;
      svg.pauseAnimations();
      if (reduceMotion) return;
      var card = svg.closest('.project-card');
      card.addEventListener('mouseenter', function() { svg.unpauseAnimations(); });
      card.addEventListener('mouseleave', function() { svg.pauseAnimations(); });
    });

    var group = document.querySelector('#projects .segmented');
    if (!group) return;
    var btns = group.querySelectorAll('.segmented__btn');
    var cards = document.querySelectorAll('#projects .project-card');

    // Re-flow the wide/narrow rhythm over the cards that remain visible
    function relayout() {
      var visible = Array.prototype.filter.call(cards, function(c) { return !c.classList.contains('is-hidden'); });
      visible.forEach(function(c, i) {
        c.setAttribute('data-wide', (i % 4 === 0 || i % 4 === 3) ? 'true' : 'false');
        c.removeAttribute('data-solo');
      });
      if (visible.length % 2 === 1) visible[visible.length - 1].setAttribute('data-solo', 'true');
    }

    btns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var filter = btn.getAttribute('data-filter');
        cards.forEach(function(card) {
          var show = filter === 'all' || card.getAttribute('data-company') === filter;
          card.classList.toggle('is-hidden', !show);
          card.classList.remove('is-entering');
          if (show) {
            void card.offsetWidth;
            card.classList.add('is-entering');
          }
        });
        relayout();
      });
    });
  });
</script>
