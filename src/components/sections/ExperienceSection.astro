    ],
    techTags: ['Zabbix', 'Elastic', 'Pandora FMS', 'SAP Logon', 'ServiceAide', 'Linux Servers', 'SLA Management']
  }
];
---

<section id="experience" class="portfolio-section" data-tone="light" aria-labelledby="exp-title">
  <div class="container">
    <div class="eyebrow">
      <span class="signal-dot"></span>
      <span data-lang="es">Trayectoria Profesional</span>
      <span data-lang="en">Work Experience</span>
    </div>

    <div class="section-header">
      <h2 id="exp-title">
        <span data-lang="es">Experiencia en Producción</span>
        <span data-lang="en">Production Track Record</span>
      </h2>
      <div class="section-description">
        <p data-lang="es">Liderazgo y ejecución técnica en infraestructura cloud, plataformas de contenedores en producción, DevSecOps y observabilidad transaccional.</p>
        <p data-lang="en">Technical leadership and execution across cloud infrastructure, production container platforms, DevSecOps, and transactional observability.</p>
      </div>
    </div>

    <!-- Timeline: the rail fills with light as you scroll through it -->
    <div class="timeline">
      <span class="timeline__rail" aria-hidden="true"><span class="timeline__fill"></span></span>
      <ol class="timeline__list">

      {experiences.map((exp, i) => (
        <li class={`tl-item ${i === 0 ? 'tl-item--current' : ''}`}>
          <span class="tl-node" aria-hidden="true"></span>

          <!-- Left: when & where (sticky while the entry is on screen) -->
          <div class="tl-when">
            <div class="tl-when__inner">
              <div class="tl-logo">
                {exp.logoColor ? (
                  <span class="tl-logo__dual">
                    <img src={exp.logoWhite} alt={exp.logoAlt} class="tl-logo__img logo-default-white" loading="lazy" />
                    <img src={exp.logoColor} alt="" aria-hidden="true" class="tl-logo__img logo-hover-color" loading="lazy" />
                  </span>
                ) : (
                  <img src={exp.logoWhite} alt={exp.logoAlt} class="tl-logo__img logo-filter-white" loading="lazy" />
                )}
              </div>
              <span class="tl-date" data-lang="es">{exp.dateEs}</span>
              <span class="tl-date" data-lang="en">{exp.dateEn}</span>
              <span class="tl-place" data-lang="es">{exp.locationEs}</span>
              <span class="tl-place" data-lang="en">{exp.locationEn}</span>
            </div>
          </div>

          <!-- Right: role and impact -->
          <div class="tl-body">
            <p class="tl-company">{exp.company}</p>
            <h3 class="tl-role" data-lang="es">{exp.roleEs}</h3>
            <h3 class="tl-role" data-lang="en">{exp.roleEn}</h3>

            <ul class="tl-points" data-lang="es">
              {exp.bulletsEs.map((b) => <li>{b}</li>)}
            </ul>
            <ul class="tl-points" data-lang="en">
              {exp.bulletsEn.map((b) => <li>{b}</li>)}
            </ul>

            <div class="tl-tags">
              {exp.techTags.map((tech) => <span class="tag">{tech}</span>)}
            </div>
          </div>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* ========================================================
     Experience — scroll-lit timeline
     ======================================================== */
  .timeline {
    --rail-x: 260px;
    position: relative;
  }

  .timeline__list {
    display: flex;
    flex-direction: column;
  }

  .timeline__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--rail-x);
    width: 1px;
    background: var(--line);
  }

  .timeline__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--aurora-glacier), var(--aurora-iris) 50%, var(--aurora-bloom));
    box-shadow: 0 0 12px rgba(124, 108, 255, 0.6);
    transform-origin: top;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline__fill {
        animation: rail-fill linear both;
        animation-timeline: --timeline;
        animation-range: entry 40% exit 60%;
      }

      .timeline {
        view-timeline-name: --timeline;
      }

      @keyframes rail-fill {
        from { transform: scaleY(0); }
        to { transform: scaleY(1); }
      }
    }
  }

  /* ---- Entry ---- */
  .tl-item {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail-x) minmax(0, 1fr);
    padding: 3rem 0;
  }

  .tl-item + .tl-item {
    border-top: 1px solid var(--line-dim);
  }

  .tl-node {
    position: absolute;
    top: 3.6rem;
    left: var(--rail-x);
    width: 13px;
    height: 13px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: var(--bg-primary);
    border: 2px solid var(--text-dim);
    transition: border-color var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base);
  }

  .tl-item:hover .tl-node,
  .tl-item--current .tl-node {
    border-color: var(--aurora-glacier);
    background: var(--aurora-glacier);
    box-shadow: 0 0 0 5px rgba(62, 200, 255, 0.15), 0 0 18px rgba(62, 200, 255, 0.7);
  }

  .tl-item--current .tl-node {
    animation: node-pulse 2.4s ease-in-out infinite;
  }

  @keyframes node-pulse {
    50% { box-shadow: 0 0 0 10px rgba(62, 200, 255, 0), 0 0 18px rgba(62, 200, 255, 0.7); }
  }

  /* ---- Left column ---- */
  .tl-when {
    padding-right: 3rem;
  }

  .tl-when__inner {
    position: sticky;
    top: 7rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .tl-logo {
    height: 40px;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
  }

  .tl-logo__dual {
    position: relative;
    display: inline-flex;
    height: 100%;
  }

  .tl-logo__img {
    height: 36px;
    width: auto;
    max-width: 130px;
    object-fit: contain;
    transition: opacity var(--transition-base), filter var(--transition-base);
  }

  .logo-hover-color {
    position: absolute;
    inset: 0 auto auto 0;
    opacity: 0;
  }

  /* white artwork turns to ink when the page is light */
  .logo-default-white {
    filter: var(--logo-mono);
  }

  .tl-item:hover .logo-default-white { opacity: 0; }
  .tl-item:hover .logo-hover-color { opacity: 1; }

  .logo-filter-white {
    filter: var(--logo-mono);
    opacity: 0.85;
  }

  .tl-item:hover .logo-filter-white {
    filter: none;
    opacity: 1;
  }

  .tl-date {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .tl-item--current .tl-date {
    background: var(--aurora);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tl-place {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* ---- Right column ---- */
  .tl-body {
    padding-left: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: transform var(--transition-slow);
  }

  .tl-item:hover .tl-body {
    transform: translateX(6px);
  }

  .tl-company {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .tl-role {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 0.75rem;
  }

  .tl-points {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 68ch;
    counter-reset: point;
  }

  .tl-points li {
    position: relative;
    padding-left: 1.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .tl-points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.7rem;
    height: 1px;
    background: var(--text-muted);
    transition: width var(--transition-base), background-color var(--transition-base);
  }

  .tl-item:hover .tl-points li::before {
    width: 0.95rem;
    background: var(--aurora-glacier);
  }

  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.25rem;
  }

  @media (max-width: 900px) {
    .timeline {
      --rail-x: 6px;
    }

    .tl-item {
      grid-template-columns: 1fr;
      padding: 2.25rem 0 2.25rem 2rem;
    }

    .tl-node {
      top: 2.6rem;
    }

    .tl-when {
      padding: 0 0 1.25rem;
    }

    .tl-when__inner {
      position: static;
    }

    .tl-body {
      padding-left: 0;
    }

    .tl-item:hover .tl-body {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tl-item--current .tl-node {
      animation: none;
    }
  }
</style>
