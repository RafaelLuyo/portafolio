---
/**
 * ExperienceSection — career as a scroll-lit timeline.
 * Left column (sticky): logo, dates, place. Right column: role, impact, stack.
 * The rail fills with light as you scroll; logos switch to colour on hover.
 */

interface Experience {
  id: string;
  company: string;
  logoWhite: string;
  logoColor?: string;
  isFilter?: boolean;
  logoAlt: string;
  roleEs: string;
  roleEn: string;
  dateEs: string;
  dateEn: string;
  locationEs: string;
  locationEn: string;
  bulletsEs: string[];
  bulletsEn: string[];
  techTags: string[];
}

const experiences: Experience[] = [
  // 1. BCRP / TAPP
  {
    id: 'bcrp-tapp',
    company: 'BCRP / TAPP',
    logoWhite: '/assets/logos/tapp_white.png',
    logoColor: '/assets/logos/tapp.png',
    logoAlt: 'TAPP Logo',
    roleEs: 'Especialista DevOps',
    roleEn: 'DevOps Specialist',
    dateEs: 'Ago 2026 – Presente',
    dateEn: 'Aug 2026 – Present',
    locationEs: 'Lima, Perú (Híbrido)',
    locationEn: 'Lima, Peru (Hybrid)',
    bulletsEs: [
      'Liderazgo en la estrategia integral de CI/CD para el despliegue continuo de microservicios transaccionales de alta concurrencia en TAPP.',
      'Implementación de pipelines automatizados con GitLab CI y Jenkins, gobernanza GitOps con ArgoCD y Red Hat ACM sobre OpenShift.',
      'Gestión de secretos con HashiCorp Vault, pasarelas API en IBM API Connect y observabilidad integral con el stack ELK, OpenTelemetry & Tempo.'
    ],
    bulletsEn: [
      'Led the end-to-end CI/CD platform strategy for continuous deployment of high-throughput transactional microservices at TAPP.',
      'Engineered automated pipelines with GitLab CI and Jenkins, multi-cluster GitOps with ArgoCD and Red Hat ACM on OpenShift.',
      'Secured credentials with HashiCorp Vault, orchestrated IBM API Connect gateways, and established full-stack observability with ELK, OpenTelemetry & Tempo.'
    ],
    techTags: ['OpenShift', 'ArgoCD', 'GitLab CI', 'Jenkins', 'HashiCorp Vault', 'Nexus', 'IBM API Connect', 'OpenTelemetry']
  },

  // 2. PROMART
  {
    id: 'promart',
    company: 'PROMART',
    logoWhite: '/assets/logos/promart.png',
    isFilter: true,
    logoAlt: 'Promart Logo',
    roleEs: 'Analista Cloud',
    roleEn: 'Cloud Analyst',
    dateEs: 'Nov 2025 – Jul 2026',
    dateEn: 'Nov 2025 – Jul 2026',
    locationEs: 'San Borja, Perú (Híbrido)',
    locationEn: 'San Borja, Peru (Hybrid)',
    bulletsEs: [
      'Despliegue de clúster Kubernetes RKE2 en alta disponibilidad con Cilium CNI (eBPF) on-premise y administración centralizada con Rancher Manager en GKE.',
      'Liderazgo en la migración de release pipelines clásicos a pipelines declarativos YAML como código en Azure DevOps.',
      'Modernización de red perimetral implementando Cloud Gateway API en GCP y Envoy Proxy en RKE2 on-premise, junto con optimizaciones FinOps.'
    ],
    bulletsEn: [
      'Deployed production high-availability RKE2 Kubernetes with eBPF Cilium CNI on-premise, managed centrally via Rancher Manager on GKE.',
      'Led enterprise modernization from legacy classic release pipelines to version-controlled declarative YAML pipelines in Azure DevOps.',
      'Modernized perimeter networking implementing Cloud Gateway API in GCP and Envoy Proxy on on-premise RKE2, alongside FinOps optimizations.'
    ],
    techTags: ['Google Cloud', 'Kubernetes GKE', 'Cloud Run', 'Rancher', 'Cilium eBPF', 'Azure DevOps', 'FinOps']
  },

  // 3. OREXE
  {
    id: 'orexe',
    company: 'OREXE',
    logoWhite: '/assets/logos/orexe_white.png',
    logoColor: '/assets/logos/orexe_green.png',
    logoAlt: 'Orexe Logo',
    roleEs: 'Ingeniero de Software & Cloud',
    roleEn: 'Software & Cloud Engineer',
    dateEs: 'Jul 2025 – Nov 2025',
    dateEn: 'Jul 2025 – Nov 2025',
    locationEs: 'Remoto (Perú)',
    locationEn: 'Remote (Peru)',
    bulletsEs: [
      'Migración de más de 40 repositorios desde Azure DevOps a GitHub Enterprise, integrando agentes de IA en PRs con GitHub Copilot.',
      'Establecimiento de políticas de gobernanza a nivel de repositorios: branch protection, branch policies y escaneo automatizado de secretos.',
      'Migración de Pod Identity a Workload Identity con federación OIDC en Azure AKS mediante Terraform (IaC).'
    ],
    bulletsEn: [
      'Migrated 40+ repositories from Azure DevOps to GitHub Enterprise, integrating AI review agents into PRs with GitHub Copilot.',
      'Established repository governance standards: branch protection policies and automated secret scanning.',
      'Migrated Pod Identity to Workload Identity with OIDC federation in Azure AKS via Terraform (IaC).'
    ],
    techTags: ['Azure AKS', 'Terraform', 'GitHub Actions', 'GitHub Copilot', 'OIDC Identity', 'DevSecOps']
  },

  // 4. CANVIA
  {
    id: 'canvia',
    company: 'CANVIA',
    logoWhite: '/assets/logos/canvia.png',
    isFilter: true,
    logoAlt: 'Canvia Logo',
    roleEs: 'Analista de Infraestructura TI',
    roleEn: 'IT Infrastructure Analyst',
    dateEs: 'Feb 2025 – Jul 2025',
    dateEn: 'Feb 2025 – Jul 2025',
